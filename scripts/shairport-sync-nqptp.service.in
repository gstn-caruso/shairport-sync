[Unit]
Description=Shairport Sync NQPTP timing companion
Wants=network-online.target
After=network.target network-online.target

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/shairport-sync-nqptp
DynamicUser=yes
LimitRTPRIO=6
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
